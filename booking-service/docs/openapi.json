{
  "openapi": "3.0.3",
  "info": {
    "title": "Booking Service API",
    "version": "1.0.0",
    "description": "Pelanggan, motor, dan booking servis. Berkomunikasi dengan Workshop Service lewat REST."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Customers"
    },
    {
      "name": "Motorcycles"
    },
    {
      "name": "Bookings"
    }
  ],
  "paths": {
    "/customers": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Daftar Customers",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Customer"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Customers"
        ],
        "summary": "Tambah Customers",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "description": "Data tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Detail Customers",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Customers"
        ],
        "summary": "Ubah Customers",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diubah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Customers"
        ],
        "summary": "Hapus Customers",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dihapus"
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/motorcycles": {
      "get": {
        "tags": [
          "Motorcycles"
        ],
        "summary": "Daftar Motorcycles",
        "parameters": [
          {
            "name": "customer_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Motorcycle"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Motorcycles"
        ],
        "summary": "Tambah Motorcycles",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MotorcycleInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Motorcycle"
                }
              }
            }
          },
          "400": {
            "description": "Data tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/motorcycles/{id}": {
      "get": {
        "tags": [
          "Motorcycles"
        ],
        "summary": "Detail Motorcycles",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Motorcycle"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Motorcycles"
        ],
        "summary": "Ubah Motorcycles",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MotorcycleInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diubah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Motorcycle"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Motorcycles"
        ],
        "summary": "Hapus Motorcycles",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dihapus"
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/bookings": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Daftar booking",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customer_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "motorcycle_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Buat booking",
        "description": "Memvalidasi layanan (GET /services/{id}) dan memesan slot (PUT /slots/{id}) di Workshop Service.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDetail"
                }
              }
            }
          },
          "400": {
            "description": "Data tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Layanan/slot tidak ada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Slot sudah dibooking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Workshop Service tidak dapat dihubungi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/bookings/{id}": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Detail booking (digabung data Workshop Service)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDetail"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Bookings"
        ],
        "summary": "Ubah status / catatan / jadwal (reschedule)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diubah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDetail"
                }
              }
            }
          },
          "400": {
            "description": "Data tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Slot baru sudah dibooking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Bookings"
        ],
        "summary": "Batalkan/hapus booking dan buka kembali slot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dihapus"
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "example": "Andi Pratama"
          },
          "phone": {
            "type": "string",
            "example": "081234567890"
          },
          "email": {
            "type": "string",
            "example": "andi@mail.com"
          }
        }
      },
      "CustomerInput": {
        "type": "object",
        "required": [
          "name",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Andi Pratama"
          },
          "phone": {
            "type": "string",
            "example": "081234567890"
          },
          "email": {
            "type": "string",
            "example": "andi@mail.com"
          }
        }
      },
      "Motorcycle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "customer_id": {
            "type": "integer"
          },
          "plate_number": {
            "type": "string",
            "example": "H 1234 AB"
          },
          "brand": {
            "type": "string",
            "example": "Honda"
          },
          "model": {
            "type": "string",
            "example": "Beat"
          },
          "year": {
            "type": "integer",
            "example": 2020
          }
        }
      },
      "MotorcycleInput": {
        "type": "object",
        "required": [
          "customer_id",
          "plate_number"
        ],
        "properties": {
          "customer_id": {
            "type": "integer"
          },
          "plate_number": {
            "type": "string",
            "example": "H 1234 AB"
          },
          "brand": {
            "type": "string",
            "example": "Honda"
          },
          "model": {
            "type": "string",
            "example": "Beat"
          },
          "year": {
            "type": "integer",
            "example": 2020
          }
        }
      },
      "BookingCreate": {
        "type": "object",
        "required": [
          "customer_id",
          "motorcycle_id",
          "service_id",
          "slot_id"
        ],
        "properties": {
          "customer_id": {
            "type": "integer"
          },
          "motorcycle_id": {
            "type": "integer"
          },
          "service_id": {
            "type": "integer",
            "description": "ID layanan di Workshop Service"
          },
          "slot_id": {
            "type": "integer",
            "description": "ID slot di Workshop Service"
          },
          "complaint_note": {
            "type": "string",
            "example": "Mesin kasar saat digas"
          }
        }
      },
      "BookingUpdate": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "in_progress",
              "completed",
              "cancelled"
            ]
          },
          "complaint_note": {
            "type": "string"
          },
          "slot_id": {
            "type": "integer",
            "description": "Isi untuk reschedule"
          }
        }
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "customer_id": {
            "type": "integer"
          },
          "motorcycle_id": {
            "type": "integer"
          },
          "service_id": {
            "type": "integer",
            "description": "ID layanan di Workshop Service"
          },
          "slot_id": {
            "type": "integer",
            "description": "ID slot di Workshop Service"
          },
          "complaint_note": {
            "type": "string",
            "example": "Mesin kasar saat digas"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "in_progress",
              "completed",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BookingDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Booking"
          },
          {
            "type": "object",
            "properties": {
              "service": {
                "type": "object",
                "nullable": true
              },
              "slot": {
                "type": "object",
                "nullable": true
              },
              "mechanic": {
                "type": "object",
                "nullable": true
              }
            }
          }
        ]
      }
    }
  }
}