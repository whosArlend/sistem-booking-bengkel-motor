{
  "openapi": "3.0.3",
  "info": {
    "title": "Workshop Service API",
    "version": "1.0.0",
    "description": "Data master bengkel: layanan servis, mekanik, dan slot jadwal."
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
