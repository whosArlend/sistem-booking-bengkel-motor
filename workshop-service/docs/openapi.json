    "/slots": {
      "get": {
        "tags": [
          "Slots"
        ],
        "summary": "Daftar Slots",
        "parameters": [
          {
            "name": "mechanic_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slot_date",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "is_booked",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Slot"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Slots"
        ],
        "summary": "Tambah Slots",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SlotInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Slot"
                }
              }
            }
          },
          "400": {
            "description": "Data tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/slots/{id}": {
      "get": {
        "tags": [
          "Slots"
        ],
        "summary": "Detail Slots",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Slot"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Slots"
        ],
        "summary": "Ubah Slots",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SlotInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diubah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Slot"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Slot sudah dibooking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Jika body berisi {\"is_booked\": true}, slot dipesan secara atomik; 409 jika sudah terisi. Dipakai Booking Service."
      },
      "delete": {
        "tags": [
          "Slots"
        ],
        "summary": "Hapus Slots",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dihapus"
          },
          "404": {
            "description": "Tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Wajib untuk POST/PUT/DELETE bila INTERNAL_API_KEY diatur"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Service": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "example": "Ganti Oli"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "example": 55000
          },
          "duration_minutes": {
            "type": "integer",
            "example": 30
          }
        }
      },
      "ServiceInput": {
        "type": "object",
        "required": [
          "name",
          "price",
          "duration_minutes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Ganti Oli"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "example": 55000
          },
          "duration_minutes": {
            "type": "integer",
            "example": 30
          }
        }
      },
      "Mechanic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "example": "Budi"
          },
          "specialization": {
            "type": "string",
            "example": "Mesin"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "MechanicInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Budi"
          },
          "specialization": {
            "type": "string",
            "example": "Mesin"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "Slot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "mechanic_id": {
            "type": "integer"
          },
          "slot_date": {
            "type": "string",
            "format": "date",
            "example": "2026-12-01"
          },
          "start_time": {
            "type": "string",
            "example": "09:00:00"
          },
          "end_time": {
            "type": "string",
            "example": "10:00:00"
          },
          "is_booked": {
            "type": "boolean"
          }
        }
      },
      "SlotInput": {
        "type": "object",
        "required": [
          "mechanic_id",
          "slot_date",
          "start_time",
          "end_time"
        ],
        "properties": {
          "mechanic_id": {
            "type": "integer"
          },
          "slot_date": {
            "type": "string",
            "format": "date",
            "example": "2026-12-01"
          },
          "start_time": {
            "type": "string",
            "example": "09:00:00"
          },
          "end_time": {
            "type": "string",
            "example": "10:00:00"
          },
          "is_booked": {
            "type": "boolean"
          }
        }
      }
    }
  }
}